<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 定義報表動作 -->
    <record id="action_report_zhongyidao_saleorder" model="ir.actions.report">
        <field name="name">中一刀報價單</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">jasmine.report_zhongyidao_saleorder</field>
        <field name="report_file">jasmine.report_zhongyidao_saleorder</field>
        <field name="print_report_name">'中一刀報價單 - %s' % object.name</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
    </record>

    <!-- 定義報表模板 -->
    <template id="report_zhongyidao_saleorder">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <!-- 設定語言 -->
                <t t-set="lang" t-value="doc.partner_id.lang or 'zh_TW'"/>
                <t t-set="o" t-value="doc.with_context(lang=lang)"/>
                
                <!-- 計算總頁數 -->
                <t t-set="item_count" t-value="len(doc.order_line)"/>
                <t t-set="total_pages" t-value="(item_count + 9) // 10"/>
                <t t-if="total_pages == 0">
                    <t t-set="total_pages" t-value="1"/>
                </t>
                
                <!-- 分頁處理 -->
                <t t-foreach="range(total_pages)" t-as="page">
                    <t t-set="start_idx" t-value="page * 10"/>
                    <t t-set="end_idx" t-value="min((page + 1) * 10, item_count)"/>
                    <t t-set="is_last_page" t-value="page == total_pages - 1"/>
                    <t t-set="current_page" t-value="page + 1"/>
                    
                    <!-- 生成頁面 -->
                    <div class="article" style="page-break-after: always;">
                        <div class="page" style="font-family: 細明體; position: relative;">
                            <!-- CSS 樣式設定 -->
                            <style>
                                @page {
                                    size: 140mm 210mm;
                                    margin: 7mm;
                                }
                                
                                body, html {
                                    height: auto !important;
                                }
                                
                                /* 防止生成文本層 */
                                .text-layer-wrapper, .textLayer {
                                    display: none !important;
                                    border: none !important;
                                }
                                
                                /* 覆蓋所有可能的表格邊框 */
                                table, tr, td, th, thead, tbody, tfoot {
                                    border: none !important;
                                    border-bottom: none !important;
                                    border-top: none !important;
                                    border-left: none !important;
                                    border-right: none !important;
                                }
                                
                                .table {
                                    border-collapse: collapse !important;
                                }
                                
                                .order-row {
                                    height: 24px !important;
                                    min-height: 24px !important;
                                    max-height: 24px !important;
                                    line-height: 24px !important;
                                }
                                
                                .order-cell {
                                    padding: 0 !important;
                                    vertical-align: middle !important;
                                }
                            </style>
                            
                            <!-- 修改：增加頂部間距，移動整個頁面內容向下 -->
                            <div style="height: 2em;"></div>
                            
                            <!-- 標題區域 -->
                            <div class="page-header">
                                <div class="text-center" style="margin-bottom: 24px;">
                                    <h1 style="font-size: 24px; letter-spacing: 1em;">銷售訂單</h1>
                                </div>
                                
                                <!-- 基本資訊表格 (放在TABLE外) -->
                                <table class="table table-sm" style="margin: 0; border-collapse: collapse; width: 100%;">
                                    <!-- 第一行：客戶代號、日期、單號 -->
                                    <tr style="margin-top: -1em; position: relative; top: -1em;">
                                        <td style="width: 35%; padding: 1px 5px;">
                                            <div style="display: flex; align-items: center; height: 24px;">
                                                <span style="visibility: hidden;">公司編號：</span>
                                                <span t-field="doc.partner_vendor_code"/>
                                            </div>
                                        </td>
                                        <td style="width: 35%; padding: 1px 5px; text-align: center;">
                                            <div style="display: flex; justify-content: center; height: 24px;">
                                                <span style="visibility: hidden;">年</span>
                                                <span style="position: absolute; margin-left: -8em;" t-esc="context_timestamp(doc.date_order).strftime('%Y')"/>
                                                <span style="visibility: hidden;">月</span>
                                                <span style="position: absolute; margin-left: -3em;" t-esc="context_timestamp(doc.date_order).strftime('%m')"/>
                                                <span style="visibility: hidden;">日</span>
                                                <span style="position: absolute; margin-left: 0em;" t-esc="context_timestamp(doc.date_order).strftime('%d')"/>
                                            </div>
                                        </td>
                                        <td style="width: 30%; padding: 1px 5px; text-align: right;">
                                            <div style="display: flex; align-items: center; justify-content: flex-end; height: 24px;">
                                                <span t-field="doc.name"/>
                                                <span style="margin: 0 4px;"></span>
                                                製單: <span t-field="doc.employee_user_id.name"/>
                                            </div>
                                        </td>
                                    </tr>
                                    
                                    <!-- 第二行：客戶名稱、統一編號 -->
                                    <tr style="font-size: 15px; line-height: 16px;">
                                        <td colspan="2" style="padding: 1px 3px;">
                                            <span style="visibility: hidden;">客戶名稱：</span>
                                            <span style="display: inline-block; text-indent: 1em;">
                                                <span t-field="doc.partner_id.name"/>
                                            </span>
                                        </td>
                                        <td style="padding: 1px 3px;">
                                            <span style="visibility: hidden;">統一編號：</span>
                                            <span style="display: inline-block; text-indent: 1em;">
                                                <span t-field="doc.partner_vat_number"/>
                                            </span>
                                        </td>
                                    </tr>
                                    
                                    <!-- 第三行：公司地址、發票號碼 -->
                                    <tr style="font-size: 15px; line-height: 16px;">
                                        <td colspan="2" style="padding: 1px 3px;">
                                            <span style="visibility: hidden;">公司地址：</span>
                                            <span style="display: inline-block; text-indent: 1em;">
                                                <t t-if="doc.partner_id.street">
                                                    <span t-field="doc.partner_id.street"/>,
                                                </t>
                                                <t t-if="doc.partner_id.street2">
                                                    <span t-field="doc.partner_id.street2"/>,
                                                </t>
                                                <t t-if="doc.partner_id.city">
                                                    <span t-field="doc.partner_id.city"/>,
                                                </t>
                                                <t t-if="doc.partner_id.zip">
                                                    <span t-field="doc.partner_id.zip"/>,
                                                </t>
                                                <t t-if="doc.partner_id.state_id">
                                                    <span t-field="doc.partner_id.state_id.name"/>,
                                                </t>
                                                <t t-if="doc.partner_id.country_id">
                                                    <span t-field="doc.partner_id.country_id.name"/>
                                                </t>
                                            </span>
                                        </td>
                                        <td style="padding: 1px 3px;">
                                            <span style="visibility: hidden;">發票號碼：</span>
                                            <span style="display: inline-block; text-indent: 1em;">
                                                <!-- 發票號碼 -->
                                            </span>
                                        </td>
                                    </tr>
                                    
                                    <!-- 第四行：送貨地址、業務姓名 -->
                                    <tr style="font-size: 15px; line-height: 16px;">
                                        <td colspan="2" style="padding: 1px 3px;">
                                            <span style="visibility: hidden;">送貨地址：</span>
                                            <span style="display: inline-block; text-indent: 1em;">
                                                <t t-if="doc.partner_shipping_id.street">
                                                    <span t-field="doc.partner_shipping_id.street"/>,
                                                </t>
                                                <t t-if="doc.partner_shipping_id.street2">
                                                    <span t-field="doc.partner_shipping_id.street2"/>,
                                                </t>
                                                <t t-if="doc.partner_shipping_id.city">
                                                    <span t-field="doc.partner_shipping_id.city"/>,
                                                </t>
                                                <t t-if="doc.partner_shipping_id.zip">
                                                    <span t-field="doc.partner_shipping_id.zip"/>,
                                                </t>
                                                <t t-if="doc.partner_shipping_id.state_id">
                                                    <span t-field="doc.partner_shipping_id.state_id.name"/>,
                                                </t>
                                                <t t-if="doc.partner_shipping_id.country_id">
                                                    <span t-field="doc.partner_shipping_id.country_id.name"/>
                                                </t>
                                            </span>
                                        </td>
                                        <td style="padding: 1px 3px;">
                                            <span style="visibility: hidden;">業務姓名：</span>
                                            <span style="display: inline-block; text-indent: 1em;">
                                                <span t-field="doc.employee_user_id.name"/>
                                            </span>
                                        </td>
                                    </tr>
                                    
                                    <!-- 第五行：連絡電話、連絡人、倉庫別 -->
                                    <tr style="font-size: 15px; line-height: 16px;">
                                        <td style="padding: 1px 3px;">
                                            <span style="visibility: hidden;">連絡電話：</span>
                                            <span style="display: inline-block; text-indent: 1em;">
                                                <span t-field="doc.partner_id.phone"/>
                                            </span>
                                        </td>
                                        <td style="padding: 1px 3px;">
                                            <span style="visibility: hidden;">連絡人：</span>
                                            <span style="display: inline-block; text-indent: -1em;">
                                                <span t-field="doc.partner_id.name"/>
                                            </span>
                                        </td>
                                        <td style="padding: 1px 3px;">
                                            <span style="visibility: hidden;">倉庫別：</span>
                                            <span style="display: inline-block; text-indent: 1em;">
                                                <!-- 倉庫別 -->
                                            </span>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                            
                            <!-- 商品明細表格 -->
                            <div class="page-content">
                                <div style="height: 5px;"></div>
                                <table class="table table-sm" style="margin: 0; border-collapse: collapse; width: 100%;">
                                    <thead>
                                        <tr style="font-size: 15px;">
                                            <th style="width: 15%; visibility: hidden; padding: 1px;">產品編號</th>
                                            <th style="width: 25%; visibility: hidden; padding: 1px;">品名 / 規格</th>
                                            <th style="width: 13%; visibility: hidden; padding: 1px;" class="text-right">數量</th>
                                            <th style="width: 10%; visibility: hidden; padding: 1px;" class="text-right">單價</th>
                                            <th style="width: 15%; visibility: hidden; padding: 1px;" class="text-right">金額</th>
                                            <th style="width: 10%; visibility: hidden; padding: 1px;">備註</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <!-- 只顯示當前頁的訂單行 -->
                                        <t t-foreach="doc.order_line[start_idx:end_idx]" t-as="line">
                                            <tr style="font-size: 15px;">
                                                <td style="padding: 1px;">
                                                    <t t-if="line.product_id and line.product_id.default_code">
                                                        <span t-field="line.product_id.default_code"/>
                                                    </t>
                                                </td>
                                                <td style="padding: 1px;">
                                                    <t t-if="line.product_id">
                                                        <span t-field="line.product_id.name"/>
                                                        <span t-if="line.product_id.product_template_attribute_value_ids">
                                                            <t t-foreach="line.product_id.product_template_attribute_value_ids" t-as="attr">
                                                                <span t-field="attr.name"/>
                                                            </t>
                                                        </span>
                                                    </t>
                                                    <t t-else="">
                                                        <!-- 備註行：顯示name內容 -->
                                                        <span t-field="line.name" style="font-size: 13px; color: #666; font-style: italic;"/>
                                                    </t>
                                                </td>
                                                <td style="padding: 1px; text-align: right; white-space: nowrap;">
                                                    <t t-if="line.product_uom_qty > 0">
                                                        <span style="margin-right: 2em;">
                                                            <t t-esc="'%.2f' % line.product_uom_qty"/> 
                                                            <t t-if="line.product_uom">
                                                                <t t-esc="line.product_uom.name"/>
                                                            </t>
                                                        </span>
                                                    </t>
                                                </td>
                                                <td style="padding: 1px; text-align: right;">
                                                    <t t-if="line.price_unit > 0">
                                                        <span style="margin-right: 1em;">
                                                            <span t-field="line.price_unit" t-options='{"widget": "float", "precision": 2}'/>
                                                        </span>
                                                    </t>
                                                </td>
                                                <td style="padding: 1px 0px 1px 1px; text-align: right;">
                                                    <t t-if="line.price_subtotal > 0">
                                                        <span style="margin-right: 3em;">
                                                            <span t-field="line.price_subtotal"/>
                                                        </span>
                                                    </t>
                                                </td>
                                                <td style="padding: 1px;"></td>
                                            </tr>
                                        </t>
                                        
                                        <!-- 空行填充，確保每頁固定10行 -->
                                        <t t-foreach="range(10 - (end_idx - start_idx))" t-as="i">
                                            <tr class="order-row">
                                                <td class="order-cell">&amp;nbsp;</td>
                                                <td class="order-cell">&amp;nbsp;</td>
                                                <td class="order-cell">&amp;nbsp;</td>
                                                <td class="order-cell">&amp;nbsp;</td>
                                                <td class="order-cell">&amp;nbsp;</td>
                                                <td class="order-cell">&amp;nbsp;</td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                                
                                <!-- 僅在最後一頁顯示金額合計 -->
                                <t t-if="is_last_page">
                                    <!-- 增加空白區域，推動金額區塊往下 -->
                                    <div style="height: 70px;"></div>
                                    <div style="position: absolute; bottom: 0; right: 0; margin-bottom: 3mm; width: 100%;">
                                        <div style="text-align: right; padding-right: 8em;line-height: 0.5; ">
                                            <span style="margin: 0; padding: 0; line-height: 1; display: inline;">
                                                <span t-field="doc.amount_untaxed"/><br/>
                                                <span t-field="doc.amount_tax"/><br/>
                                                <span t-field="doc.amount_total"/>
                                            </span>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>