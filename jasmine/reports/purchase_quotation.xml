<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="custom_purchase_quotation_template" inherit_id="purchase.report_purchasequotation_document">
        <xpath expr="//t[@t-call='web.external_layout']" position="replace">
            <t t-call="web.html_container">
                <!-- 設定語言 -->
                <t t-set="lang" t-value="o.partner_id.lang or 'zh_TW'"/>

                <!-- 確保總頁數至少為 1 -->
                <t t-set="total_pages" t-value="max(1, (len(o.order_line) + 9) // 10)"/>
                
                <t t-foreach="range(total_pages)" t-as="page">
                    <t t-set="start_idx" t-value="page * 10"/>
                    <t t-set="end_idx" t-value="min((page + 1) * 10, len(o.order_line))"/> 
                    <t t-set="is_last_page" t-value="page == total_pages - 1"/>

                    <!-- 確保不會產生空白頁 -->
                    <t t-if="start_idx &lt; len(o.order_line) or page == 0">
                        <div class="page"
                            style="font-family: 細明體; padding: 0px 20px; height: auto; overflow: hidden;"
                            t-att-style="'page-break-after: always;' if page &lt; (total_pages - 1) else ''">  

                        <!-- 公司資訊區域 -->
                        <div style="text-align: center; font-size: 20px; font-weight: bold; margin-bottom: 5px;">
                            詢價單
                        </div>
                        <div style="text-align: right; font-size: 12px;">
                            公司地址：台南市海佃路二段150巷122之3號2樓<br/>
                            服務專線：06-2463690・2450025　傳真：06-2555045<br/>
                            門市地址：台南市海佃路二段109號　門市專線：06-2569747
                        </div>

                        <!-- 基本資訊表格 -->
                        <table class="table" style="width: 100%; border-collapse: collapse; table-layout: fixed; margin: 8px 0 0 0; line-height: 1.5;">
                            <!-- 第一行：供應商代號、日期、單號 -->
                            <tr>
                                <td style="width: 33.33%; padding: 1px 5px;">
                                    <span>供應商代號：</span>
                                    <span t-field="o.partner_vendor_code"/>
                                </td>
                                <td style="width: 33.33%; padding: 1px 5px; text-align: center;">
                                    <span>日期：</span>
                                    <span t-esc="context_timestamp(o.date_order).strftime('%Y-%m-%d')"/>
                                </td>
                                <td style="width: 33.33%; padding: 1px 5px; text-align: right;">
                                    <span>詢價單號：</span>
                                    <span t-field="o.name"/>
                                </td>
                            </tr>

                            <!-- 第二行：供應商名稱（佔兩列）、統一編號 -->
                            <tr>
                                <td colspan="2" style="padding: 1px 5px;">
                                    <span>供應商名稱：</span>
                                    <span t-field="o.partner_id.name"/>
                                </td>
                                <td style="padding: 1px 5px;">
                                    <span>統一編號：</span>
                                    <span t-field="o.partner_vat_number"/>
                                </td>
                            </tr>

                            <!-- 第三行：公司地址（佔兩列）、發票號碼 -->
                            <tr>
                                <td colspan="2" style="padding: 1px 5px;">
                                    <span>公司地址：</span>
                                    <span t-field="o.partner_id.contact_address"/>
                                </td>
                                <td style="padding: 1px 5px;">
                                    <span>發票號碼：</span>
                                    <span t-field="o.invoice_ids.name"/>
                                </td>
                            </tr>
                        </table>

                        <!-- 商品明細表格 -->
                        <table class="table" style="width: 100%; border-collapse: collapse; margin: 10px 0 0 0;">
                            <thead>
                                <tr style="background-color: #ddd;">
                                    <th style="width: 15%; text-align: center;">產品編號</th>
                                    <th style="width: 40%; text-align: center;">品名 / 規格</th>
                                    <th style="width: 10%; text-align: center;">數量</th>
                                    <th style="width: 15%; text-align: center;">單價</th>
                                    <th style="width: 20%; text-align: center;">金額</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.order_line[start_idx:end_idx]" t-as="line">
                                    <tr>
                                        <td style="text-align: center;"><span t-field="line.product_id.default_code"/></td>
                                        <td><span t-field="line.product_id.display_name"/></td>
                                        <td style="text-align: right;"><span t-field="line.product_qty"/> 件</td>
                                        <td style="text-align: right;"><span t-field="line.price_unit" t-options='{"widget": "float", "precision": 2}'/></td>
                                        <td style="text-align: right;"><span t-field="line.price_subtotal"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- 小計、稅額、合計 -->
                        <t t-if="is_last_page">
                            <table class="table" style="width: 100%; border-collapse: collapse; margin-top: 15px;">
                                <tr>
                                    <td style="width: 70%;"></td>
                                    <td style="text-align: right;">小計：</td>
                                    <td style="text-align: right;"><span t-field="o.amount_untaxed"/></td>
                                </tr>
                                <tr>
                                    <td></td>
                                    <td style="text-align: right;">營業稅：</td>
                                    <td style="text-align: right;"><span t-field="o.amount_tax"/></td>
                                </tr>
                                <tr>
                                    <td></td>
                                    <td style="text-align: right;">合計：</td>
                                    <td style="text-align: right;"><span t-field="o.amount_total"/></td>
                                </tr>
                            </table>
                        </t>
                    </div>
                    </t>
                </t>
            </t>
        </xpath>
    </template>
</odoo>
