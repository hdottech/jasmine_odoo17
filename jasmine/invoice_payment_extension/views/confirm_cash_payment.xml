<odoo>
    <data>
        <record id="view_account_bill_cash_wizard_form" model="ir.ui.view">
            <field name="name">account.bill.cash.wizard.form</field>
            <field name="model">account.bill.cash.wizard</field>
            <field name="arch" type="xml">
                <form string="票據兌現">
                    <group>
                        <group>
                            <field name="payment_date"/>
                            <field name="journal_id"/>
                        </group>
                        <group>
                            <field name="amount"/>
                            <field name="currency_id" />
                        </group>
                    </group>
                    <footer>
                        <button name="action_confirm" 
                                string="確認兌現" 
                                type="object" 
                                class="btn-primary"/>
                        <button string="取消" 
                                class="btn-secondary" 
                                special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
        <record id="view_account_bill_void_wizard_form" model="ir.ui.view">
            <field name="name">account.bill.void.wizard.form</field>
            <field name="model">account.bill.void.wizard</field>
            <field name="arch" type="xml">
                <form string="票據註銷">
                    <group>
                        <field name="void_date"/>
                        <field name="void_reason"/>
                    </group>
                    <footer>
                        <button name="action_confirm" 
                                string="確認" 
                                type="object" 
                                class="btn-primary"/>
                        <button string="取消" 
                                class="btn-secondary" 
                                special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>