<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 作廢單 Form View -->
    <record id="view_invoice_cancellation_form" model="ir.ui.view">
        <field name="name">invoice.cancellation.form</field>
        <field name="model">invoice.cancellation</field>
        <field name="arch" type="xml">
            <form string="發票作廢單">
                <header>
                    <button name="action_confirm" string="確認作廢" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <!-- <button name="action_cancel" string="取消" type="object"
                            class="btn-secondary" invisible="state != 'draft'"/> -->
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="invoice_id" readonly="state != 'draft'" 
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="invoice_number" readonly="1"/>
                            <field name="invoice_date" readonly="1"/>
                        </group>
                        <group>
                            <field name="cancellation_date" readonly="state != 'draft'"/>
                            <field name="cancellation_reason" readonly="state != 'draft'"/>
                            <field name="reason_detail" readonly="state != 'draft'"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- 作廢單 Tree View -->
    <record id="view_invoice_cancellation_tree" model="ir.ui.view">
        <field name="name">invoice.cancellation.tree</field>
        <field name="model">invoice.cancellation</field>
        <field name="arch" type="xml">
            <tree string="發票作廢單">
                <field name="name"/>
                <field name="invoice_number"/>
                <field name="cancellation_date"/>
                <field name="cancellation_reason"/>
                <field name="state" decoration-success="state == 'done'" decoration-info="state == 'draft'" decoration-danger="state == 'cancel'"/>
            </tree>
        </field>
    </record>

    <!-- 作廢單 Action -->
    <record id="action_invoice_cancellation" model="ir.actions.act_window">
        <field name="name">發票作廢</field>
        <field name="res_model">invoice.cancellation</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                尚無作廢單記錄
            </p>
            <p>
                請先選擇一筆電子發票，再進行作廢操作。
            </p>
        </field>
    </record>
</odoo>