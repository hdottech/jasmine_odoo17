<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 擴展貸記單表單視圖，新增查看電子發票資訊按鈕 -->
    <record id="view_account_move_form_credit_note_invoice_info" model="ir.ui.view">
        <field name="name">account.move.form.credit.note.invoice.info</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
           <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button name="action_view_related_invoice_information" type="object"
                        class="oe_stat_button" icon="fa-file-text-o"
                        invisible="move_type != 'out_refund' or state != 'posted'">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">查看電子發票資訊</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>