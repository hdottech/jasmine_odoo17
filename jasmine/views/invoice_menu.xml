<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 主選單 - 頂層獨立APP，位於會計和報告之間 -->
    <menuitem id="e_invoice" 
              name="電子發票" 
              sequence="25" 
              web_icon="account,static/description/icon.png"/>

    <!-- 發票抬頭管理 -->
    <menuitem id="menu_invoice_title"
              name="發票抬頭管理"
              parent="e_invoice"
              action="action_invoice_title"
              sequence="19"/>
            
    <!-- 發票字軌管理 -->
    <menuitem id="menu_invoice_track"
              name="發票字軌管理"
              parent="e_invoice"
              action="action_invoice_track"
              sequence="20"/>
            
    <!-- 電子發票資訊 -->
    <menuitem id="menu_invoice_information"
              name="電子發票資訊"
              parent="e_invoice"
              action="action_invoice_information"
              sequence="50"/>

    <!-- 汎宇功能子選單 -->
    <menuitem id="menu_fanyuu_functions" 
              name="汎宇電子發票" 
              parent="e_invoice" 
              sequence="110"/>

    <!-- 需要處理的發票 -->
    <record id="action_invoice_need_process" model="ir.actions.act_window">
        <field name="name">待處理發票</field>
        <field name="res_model">invoice.information</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('fanyuu_status', 'in', ['draft', 'failed'])]</field>
        <field name="context">{'create': False, 'edit': False, 'delete': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                所有待處理的發票
            </p>
            <p>這裡顯示尚未送出或處理失敗的發票，需要送出至汎宇系統。</p>
        </field>
    </record>

    <menuitem id="menu_invoice_need_process" 
              name="待處理發票" 
              parent="menu_fanyuu_functions" 
              action="action_invoice_need_process" 
              sequence="10"/>

    <!-- 處理成功的發票 -->
    <record id="action_invoice_success" model="ir.actions.act_window">
        <field name="name">處理成功發票</field>
        <field name="res_model">invoice.information</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('fanyuu_status', '=', 'success')]</field>
        <field name="context">{'create': False, 'edit': False, 'delete': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                汎宇處理成功的發票
            </p>
            <p>這些發票已成功送出至汎宇系統並獲得確認。</p>
        </field>
    </record>

    <menuitem id="menu_invoice_success" 
              name="處理成功" 
              parent="menu_fanyuu_functions" 
              action="action_invoice_success" 
              sequence="20"/>

    <!-- 處理失敗的發票 -->
    <record id="action_invoice_failed" model="ir.actions.act_window">
        <field name="name">處理失敗發票</field>
        <field name="res_model">invoice.information</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('fanyuu_status', '=', 'failed')]</field>
        <field name="context">{'create': False, 'edit': False, 'delete': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                汎宇處理失敗的發票
            </p>
            <p>這些發票在送出至汎宇系統時發生錯誤，需要檢查並重新處理。</p>
        </field>
    </record>

    <menuitem id="menu_invoice_failed" 
              name="處理失敗" 
              parent="menu_fanyuu_functions" 
              action="action_invoice_failed" 
              sequence="30"/>

    <!-- 發票號碼管理 - 需要先定義對應的 action -->
    <!-- <menuitem id="menu_invoice_number_management" 
              name="發票號碼管理" 
              parent="menu_fanyuu_functions" 
              action="action_invoice_number_management" 
              sequence="40"/> -->

    <!-- 發票作廢記錄 -->
    <menuitem id="menu_invoice_cancellation" 
              name="發票作廢記錄" 
              parent="menu_fanyuu_functions" 
              action="action_invoice_cancellation" 
              sequence="50"/>

    <!-- 快速動作選單 -->
    <!-- <menuitem id="menu_quick_actions" 
              name="快速動作" 
              parent="e_invoice" 
              sequence="120"/> -->

    <!-- 測試汎宇連線 -->
    <!-- <record id="action_test_fanyuu_connection" model="ir.actions.server">
        <field name="name">測試汎宇連線</field>
        <field name="model_id" ref="model_invoice_information"/>
        <field name="binding_model_id" ref="model_invoice_information"/>
        <field name="state">code</field>
        <field name="code">
records.action_test_connection()
        </field>
    </record> -->

    <!-- <menuitem id="menu_test_fanyuu_connection" 
              name="測試汎宇連線" 
              parent="menu_quick_actions" 
              action="action_test_fanyuu_connection" 
              sequence="20"/> -->

    <!-- 系統設定選單 -->
    <menuitem id="menu_invoice_settings" 
              name="系統設定" 
              parent="e_invoice" 
              sequence="130"/>

    <!-- 汎宇API設定 -->
    <record id="action_fanyuu_settings" model="ir.actions.act_window">
        <field name="name">汎宇API設定</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'jasmine'}</field>
    </record>

    <menuitem id="menu_fanyuu_settings" 
              name="汎宇API設定" 
              parent="menu_invoice_settings" 
              action="action_fanyuu_settings" 
              sequence="10"/>

    <!-- 看板視圖定義 -->
    <record id="view_invoice_fanyuu_kanban" model="ir.ui.view">
        <field name="name">invoice.information.fanyuu.kanban</field>
        <field name="model">invoice.information</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="fanyuu_status">
                <field name="fanyuu_status"/>
                <field name="invoice_number"/>
                <field name="buyer_name"/>
                <field name="total_amount"/>
                <field name="fanyuu_sent_time"/>
                <field name="operation_type"/>
                
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="invoice_number"/>
                                    </strong>
                                </div>
                                <div class="o_kanban_record_subtitle">
                                    <field name="buyer_name"/>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <div class="row">
                                    <div class="col-6">
                                        <span class="text-muted">金額: </span>
                                        <field name="total_amount" widget="monetary"/>
                                    </div>
                                    <div class="col-6">
                                        <span class="text-muted">狀態: </span>
                                        <field name="fanyuu_status" widget="badge"/>
                                    </div>
                                </div>
                                <div class="row" t-if="record.fanyuu_sent_time.raw_value">
                                    <div class="col-12">
                                        <span class="text-muted">送出時間: </span>
                                        <field name="fanyuu_sent_time"/>
                                    </div>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <field name="operation_type" widget="badge"/>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <button name="action_send_to_fanyuu" 
                                            type="object" 
                                            class="btn btn-sm btn-primary"
                                            t-if="record.fanyuu_status.raw_value != 'success'">
                                        送出
                                    </button>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

</odoo>