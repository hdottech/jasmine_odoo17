<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="pos_style_receipt">
        <t t-call="web.basic_layout">
            <t t-foreach="docs" t-as="o">
                <div class="page" style="font-family: 'Microsoft JhengHei', 'SimSun', sans-serif; padding: 0px 20px; width: 80mm; margin: auto;">
                    <!-- 公司資訊 -->
                    <div style="text-align: center; margin-bottom: 10px;line-height: 1;">
                        <div style="font-size: 34px; font-family: 細明體;margin: 0;font-weight: bold;" t-field="o.invoice_title_id.invoice_title"/>
                        <div style="font-size: 34px; font-family: 細明體;margin: 0;">電子發票證明聯</div>
                        <div style="font-size: 34px; font-family: 細明體;margin: 0;" t-field="o.einvoice_period"/>
                        <div style="font-size: 34px; font-family: 細明體;margin: 0;" t-field="o.einvoice_number"/>
                    </div>

                    <!-- 發票資訊 -->
                    <div style="font-family: 細明體; line-height: 0.5; margin: -5; padding: 0;">
                        <table style="width: 100%; border-collapse: collapse; font-size: 16px;">
                            <tr><td colspan="2" style="padding: 0; line-height: 1;">
                                <span t-field="o.einvoice_date" t-options='{"format": "yyyy-MM-dd HH:mm:ss"}'/>
                            </td></tr>
                            <tr>
                                <td style="width: 50%; padding: 0; line-height: 0.5;">
                                    <span>隨機碼：</span>
                                    <span style="margin-left: 2px;" t-field="o.einvoice_random_number"/>
                                </td>
                                <td style="width: 50%; padding: 0; line-height: 0.5;">
                                    <span>總計：</span>
                                    <span style="margin-left: 2px;" t-field="o.amount_total" t-options='{"widget": "float", "precision": 0}'/>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding: 0; line-height: 0.5;">
                                    <span>賣方:</span><span style="margin-left: 2px;" t-field="o.einvoice_seller_id"/>
                                </td>
                                <td style="padding: 0; line-height: 0.5;">
                                    <span>買方:</span><span style="margin-left: 2px;" t-field="o.partner_vat_number"/>
                                </td>
                            </tr>
                        </table>
                    </div>
                    <!-- 條碼區 -->
                    <div style="text-align: center; margin: 0; padding: 0; line-height: 1;">
                        <t t-if="o.barcode_image">
                            <img t-att-src="'data:image/png;base64,' + o.barcode_image" 
                                style="width: 100%; max-width: 100%; height:25px;"/>
                        </t>
                    </div>
                    <!-- QR Code 區 -->
                    <div style="text-align: center; margin: 0; padding: 0; line-height: 1;">
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <t t-if="o.left_qr_image">
                                <img t-att-src="'data:image/png;base64,' + o.left_qr_image" 
                                    style="width: 48%; height: auto; max-width: 100%;"/>
                            </t>
                            <t t-if="o.right_qr_image">
                                <img t-att-src="'data:image/png;base64,' + o.right_qr_image" 
                                    style="width: 48%; height: auto; max-width: 100%;"/>
                            </t>
                        </div>
                    </div>
                    <!-- 添加交易明細表標題 -->
                    <div style="text-align: center; font-size: 16px; font-weight: bold; margin: 10px 0 5px 0; font-family: 細明體;">
                        交易明細表
                    </div>
                    
                    <!-- 交易明細表格 -->
                    <div style="width: 100%; font-family: 細明體; font-size: 16px;">
                        <!-- 上方分隔線 -->
                        <div style="border-bottom: 1px solid black; margin: 5px 0;"></div>
                        
                        <!-- 交易資訊 -->
                        <div style="text-align: left;">
                            <span t-field="o.create_date" t-options='{"format": "yyyy-MM-dd HH:mm:ss"}'/>
                        </div>
                        <div style="text-align: left;">
                            單號：<span t-field="o.name"/>
                        </div>
                        <div style="text-align: left;">
                            發票號碼：<span t-field="o.einvoice_number"/>
                        </div>
                        <div style="text-align: left;">
                            員工：<span t-field="o.employee_user_id"/>
                        </div>
                        
                        <!-- 中間分隔線 -->
                        <div style="border-bottom: 1px solid black; margin: 5px 0;"></div>
                        
                        <!-- 商品明細 -->
                        <table style="width: 100%; border-collapse: collapse;">
                            <t t-foreach="o.invoice_line_ids" t-as="line">
                                <tr>
                                    <td style="text-align: left; padding: 1px;">
                                        <span t-field="line.product_id.name"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="text-align: right; padding: 1px;">
                                        <span t-field="line.quantity" t-options='{"widget": "float", "precision": 0}'/> x 
                                        <span t-field="line.price_unit" t-options='{"widget": "float", "precision": 0}'/> 
                                        <span style="margin-left: 10px;" t-field="line.price_subtotal" t-options='{"widget": "float", "precision": 0}'/>
                                    </td>
                                </tr>
                            </t>
                        </table>
                        
                        <!-- 下方分隔線 -->
                        <div style="border-bottom: 1px solid black; margin: 5px 0;"></div>
                    </div>

                    <!-- 金額合計 -->
                    <div style="margin-top: 10px; font-family: 細明體; font-size: 16px;">
                        <div style="display: flex; justify-content: space-between;">
                            <span style="text-align: left;">未稅金額：</span>
                            <span style="text-align: right; margin-right: 2em;" t-field="o.amount_untaxed" t-options='{"widget": "float", "precision": 0}'/>
                        </div>
                        <div style="display: flex; justify-content: space-between;">
                            <span style="text-align: left;">營業稅額：</span>
                            <span style="text-align: right; margin-right: 2em;" t-field="o.amount_tax" t-options='{"widget": "float", "precision": 0}'/>
                        </div>
                        <div style="display: flex; justify-content: space-between;">
                            <span style="text-align: left;">總計金額：</span>
                            <span style="text-align: right; margin-right: 2em;" t-field="o.amount_total" t-options='{"widget": "float", "precision": 0}'/>
                        </div>
                        <div style="display: flex; justify-content: space-between;">
                            <span style="text-align: left;">現金：</span>
                            <span style="text-align: right; margin-right: 2em;" t-field="o.payment_cash" t-options='{"widget": "float", "precision": 0}'/>
                        </div>
                        <div style="display: flex; justify-content: space-between;">
                            <span style="text-align: left;">信用卡：</span>
                            <span style="text-align: right; margin-right: 2em;" t-field="o.payment_credit" t-options='{"widget": "float", "precision": 0}'/>
                        </div>
                    </div>
                    <!-- 機器序號 -->
                    <div style="font-size: 16px; margin-top: 10px; font-family: 細明體;">
                        <span>機器序號：</span>
                        <span>001</span>
                    </div>
                </div>
            </t>
        </t>
    </template>
    <record id="action_report_einvoice" model="ir.actions.report">
        <field name="name">電子發票列印</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">jasmine.pos_style_receipt</field>
        <field name="report_file">jasmine.pos_style_receipt</field>
        <field name="print_report_name">'Receipt - %s' % object.name</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
    </record>
</odoo>